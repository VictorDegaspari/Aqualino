{
  "name": "@aqualino/mobile",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android --active-arch-only --main-activity com.aqualino.MainActivity",
    "android:all": "react-native run-android --main-activity com.aqualino.MainActivity",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit"
  },
  "codegenConfig": {
    "name": "AqualinoWidgetSpec",
    "type": "modules",
    "jsSrcsDir": "specs",
    "android": {
      "javaPackageName": "com.aqualino.widget"
    },
    "ios": {
      "modulesProvider": {
        "NativeAqualinoWidget": "RCTNativeAqualinoWidget"
      }
    }
  },
  "dependencies": {
    "@aqualino/contracts": "workspace:*",
    "@aqualino/design-tokens": "workspace:*",
    "@gorhom/bottom-sheet": "5.2.14",
    "@notifee/react-native": "^9.1.8",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native/new-app-screen": "0.87.0",
    "@react-navigation/native": "7.3.18",
    "@react-navigation/native-stack": "7.18.10",
    "@tanstack/react-query": "5.102.8",
    "react": "19.2.3",
    "react-native": "0.87.0",
    "react-native-gesture-handler": "3.2.1",
    "react-native-haptic-feedback": "3.0.0",
    "react-native-image-picker": "8.2.1",
    "react-native-keychain": "10.0.0",
    "react-native-mmkv": "4.3.2",
    "react-native-nitro-modules": "0.37.1",
    "react-native-nitro-sqlite": "9.7.0",
    "react-native-reanimated": "4.6.0",
    "react-native-safe-area-context": "5.8.1",
    "react-native-screens": "4.27.0",
    "react-native-svg": "15.15.5",
    "react-native-worklets": "0.12.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.0",
    "@react-native/eslint-config": "0.87.0",
    "@react-native/jest-preset": "0.87.0",
    "@react-native/metro-config": "0.87.0",
    "@react-native/typescript-config": "0.87.0",
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.2",
    "@types/react-test-renderer": "19.1.0",
    "eslint": "8.57.1",
    "jest": "29.7.0",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}

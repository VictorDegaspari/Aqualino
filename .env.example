APP_ENV=local
APP_NAME=Aqualino
APP_DEBUG=true
APP_KEY=
APP_URL=http://localhost:8080
APP_PORT=8080

POSTGRES_DB=aqualino
POSTGRES_USER=aqualino
POSTGRES_PASSWORD=aqualino_local_only
POSTGRES_PORT=5432

REDIS_PASSWORD=aqualino_redis_local_only
REDIS_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025

# Local: Mailpit. Use MAIL_MAILER=resend and a verified sender for real delivery.
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=Aqualino
RESEND_API_KEY=

# Only honored with APP_ENV=local. Set false to test the confirmation flow.
LOCAL_SKIP_EMAIL_VERIFICATION=true
